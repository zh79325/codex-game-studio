{
  "name": "@codex-game/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && pnpm run build:electron",
    "build:electron": "vite build --config vite.electron.config.ts --mode main && vite build --config vite.electron.config.ts --mode preload",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-query": "^5.102.6",
    "antd": "^6.6.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "electron": "37.4.0",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  }
}
